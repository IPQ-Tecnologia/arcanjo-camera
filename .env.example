# ============================================================
# Kafka
# ============================================================

KAFKA_ENABLED=false

# Um ou mais brokers separados por vírgula.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Tópicos dos eventos.
KAFKA_TOPIC_ALARM_DETECTION=arcanjo.events.alarm.detection
KAFKA_TOPIC_FACE_CAPTURE=arcanjo.events.face.capture
KAFKA_TOPIC_ERRORS=camera.events.errors

KAFKA_CLIENT_ID=camera-ingestion-api

# Protocolos suportados:
# PLAINTEXT
# SSL
# SASL_PLAINTEXT
# SASL_SSL
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# SASL - necessário apenas para SASL_PLAINTEXT ou SASL_SSL.
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# TLS / SSL.
#
# CA usada para validar o certificado do servidor Kafka.
KAFKA_SSL_CAFILE=

# Certificado e chave do cliente para autenticação mTLS.
# CERTFILE e KEYFILE devem ser configurados juntos.
KAFKA_SSL_CERTFILE=
KAFKA_SSL_KEYFILE=

# Preencher somente caso a chave privada possua senha.
KAFKA_SSL_KEY_PASSWORD=

KAFKA_REQUEST_TIMEOUT_MS=10000
KAFKA_MAX_REQUEST_SIZE=5242880


# ============================================================
# Pipeline
# ============================================================

INGESTION_QUEUE_SIZE=1000
INGESTION_WORKERS=4
SPOOL_DIRECTORY=spool
