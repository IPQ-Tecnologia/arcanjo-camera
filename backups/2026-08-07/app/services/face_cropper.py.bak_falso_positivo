from __future__ import annotations

import base64
from dataclasses import dataclass
from pathlib import Path
from typing import Any

import cv2
import numpy as np


@dataclass(frozen=True)
class FaceCropResult:
    imagem_base64: str
    caminho_arquivo: str
    x: int
    y: int
    largura: int
    altura: int

    def to_dict(self) -> dict:
        return {
            "imagem_base64": self.imagem_base64,
            "caminho_arquivo": self.caminho_arquivo,
            "bounding_box": {
                "x": self.x,
                "y": self.y,
                "largura": self.largura,
                "altura": self.altura,
            },
        }


def _carregar_detector(
    nome_arquivo: str,
) -> cv2.CascadeClassifier:
    caminho = (
        Path(cv2.data.haarcascades)
        / nome_arquivo
    )

    detector = cv2.CascadeClassifier(
        str(caminho)
    )

    if detector.empty():
        raise RuntimeError(
            f"Não foi possível carregar: {caminho}"
        )

    return detector


_DETECTOR_FRONTAL = _carregar_detector(
    "haarcascade_frontalface_default.xml"
)

_DETECTOR_PERFIL = _carregar_detector(
    "haarcascade_profileface.xml"
)


def _limitar_caixa(
    x: int,
    y: int,
    largura: int,
    altura: int,
    largura_imagem: int,
    altura_imagem: int,
) -> tuple[int, int, int, int]:
    x1 = max(0, min(x, largura_imagem - 1))
    y1 = max(0, min(y, altura_imagem - 1))

    x2 = max(
        x1 + 1,
        min(x + largura, largura_imagem),
    )

    y2 = max(
        y1 + 1,
        min(y + altura, altura_imagem),
    )

    return x1, y1, x2, y2


def _calcular_iou(
    caixa_a: tuple[int, int, int, int],
    caixa_b: tuple[int, int, int, int],
) -> float:
    ax, ay, aw, ah = caixa_a
    bx, by, bw, bh = caixa_b

    ax2 = ax + aw
    ay2 = ay + ah
    bx2 = bx + bw
    by2 = by + bh

    inter_x1 = max(ax, bx)
    inter_y1 = max(ay, by)
    inter_x2 = min(ax2, bx2)
    inter_y2 = min(ay2, by2)

    inter_w = max(0, inter_x2 - inter_x1)
    inter_h = max(0, inter_y2 - inter_y1)
    inter_area = inter_w * inter_h

    area_a = aw * ah
    area_b = bw * bh

    uniao = area_a + area_b - inter_area

    if uniao <= 0:
        return 0.0

    return inter_area / uniao


def _remover_duplicadas(
    caixas: list[tuple[int, int, int, int]],
) -> list[tuple[int, int, int, int]]:
    caixas_ordenadas = sorted(
        caixas,
        key=lambda item: item[2] * item[3],
        reverse=True,
    )

    resultado: list[
        tuple[int, int, int, int]
    ] = []

    for caixa in caixas_ordenadas:
        duplicada = any(
            _calcular_iou(caixa, existente)
            >= 0.35
            for existente in resultado
        )

        if not duplicada:
            resultado.append(caixa)

    return resultado


def _detectar_faces(
    imagem_bgr: np.ndarray,
) -> list[tuple[int, int, int, int]]:
    cinza = cv2.cvtColor(
        imagem_bgr,
        cv2.COLOR_BGR2GRAY,
    )

    cinza = cv2.equalizeHist(cinza)

    altura, largura = cinza.shape[:2]

    tamanho_minimo = max(
        24,
        min(largura, altura) // 12,
    )

    tamanho_minimo = min(
        tamanho_minimo,
        max(24, min(largura, altura)),
    )

    caixas: list[
        tuple[int, int, int, int]
    ] = []

    frontais = _DETECTOR_FRONTAL.detectMultiScale(
        cinza,
        scaleFactor=1.08,
        minNeighbors=5,
        minSize=(
            tamanho_minimo,
            tamanho_minimo,
        ),
        flags=cv2.CASCADE_SCALE_IMAGE,
    )

    caixas.extend(
        tuple(map(int, caixa))
        for caixa in frontais
    )

    perfis = _DETECTOR_PERFIL.detectMultiScale(
        cinza,
        scaleFactor=1.08,
        minNeighbors=5,
        minSize=(
            tamanho_minimo,
            tamanho_minimo,
        ),
        flags=cv2.CASCADE_SCALE_IMAGE,
    )

    caixas.extend(
        tuple(map(int, caixa))
        for caixa in perfis
    )

    cinza_invertido = cv2.flip(cinza, 1)

    perfis_invertidos = (
        _DETECTOR_PERFIL.detectMultiScale(
            cinza_invertido,
            scaleFactor=1.08,
            minNeighbors=5,
            minSize=(
                tamanho_minimo,
                tamanho_minimo,
            ),
            flags=cv2.CASCADE_SCALE_IMAGE,
        )
    )

    for x, y, largura_face, altura_face in (
        perfis_invertidos
    ):
        x_corrigido = (
            largura
            - int(x)
            - int(largura_face)
        )

        caixas.append(
            (
                x_corrigido,
                int(y),
                int(largura_face),
                int(altura_face),
            )
        )

    caixas = _remover_duplicadas(caixas)

    # Dentro do recorte da pessoa, o rosto deve
    # normalmente estar na região superior.
    caixas = [
        caixa
        for caixa in caixas
        if (
            caixa[1]
            + caixa[3] / 2
        ) <= altura * 0.72
    ]

    return caixas


def recortar_rosto(
    caminho_imagem: str,
    bounding_box: Any | None = None,
    pasta_saida: str = "recortes_faciais",
    nome_arquivo: str | None = None,
) -> FaceCropResult | None:
    imagem = cv2.imread(caminho_imagem)

    if imagem is None:
        raise ValueError(
            f"Imagem inválida: {caminho_imagem}"
        )

    altura_imagem, largura_imagem = (
        imagem.shape[:2]
    )

    origem_x = 0
    origem_y = 0
    regiao = imagem

    if bounding_box is not None:
        x1, y1, x2, y2 = _limitar_caixa(
            int(bounding_box.x),
            int(bounding_box.y),
            int(bounding_box.largura),
            int(bounding_box.altura),
            largura_imagem,
            altura_imagem,
        )

        origem_x = x1
        origem_y = y1
        regiao = imagem[y1:y2, x1:x2]

    if regiao.size == 0:
        return None

    caixas = _detectar_faces(regiao)

    if not caixas:
        return None

    # Prioriza o maior rosto detectado.
    x, y, largura_face, altura_face = max(
        caixas,
        key=lambda caixa: caixa[2] * caixa[3],
    )

    margem_x = int(largura_face * 0.25)
    margem_y = int(altura_face * 0.30)

    rx1 = max(0, x - margem_x)
    ry1 = max(0, y - margem_y)

    rx2 = min(
        regiao.shape[1],
        x + largura_face + margem_x,
    )

    ry2 = min(
        regiao.shape[0],
        y + altura_face + margem_y,
    )

    recorte = regiao[ry1:ry2, rx1:rx2]

    if recorte.size == 0:
        return None

    pasta = Path(pasta_saida)
    pasta.mkdir(
        parents=True,
        exist_ok=True,
    )

    if not nome_arquivo:
        nome_arquivo = (
            Path(caminho_imagem).stem
            + "_face.jpg"
        )

    if not nome_arquivo.lower().endswith(
        (".jpg", ".jpeg")
    ):
        nome_arquivo += ".jpg"

    caminho_saida = pasta / nome_arquivo

    sucesso = cv2.imwrite(
        str(caminho_saida),
        recorte,
        [
            cv2.IMWRITE_JPEG_QUALITY,
            94,
        ],
    )

    if not sucesso:
        raise RuntimeError(
            "Não foi possível salvar "
            "o recorte facial"
        )

    sucesso_encode, buffer = cv2.imencode(
        ".jpg",
        recorte,
        [
            cv2.IMWRITE_JPEG_QUALITY,
            94,
        ],
    )

    if not sucesso_encode:
        raise RuntimeError(
            "Não foi possível converter "
            "o recorte facial"
        )

    imagem_base64 = base64.b64encode(
        buffer.tobytes()
    ).decode("ascii")

    return FaceCropResult(
        imagem_base64=imagem_base64,
        caminho_arquivo=str(caminho_saida),
        x=origem_x + rx1,
        y=origem_y + ry1,
        largura=rx2 - rx1,
        altura=ry2 - ry1,
    )
