from __future__ import annotations

import base64
from dataclasses import dataclass
from pathlib import Path
from typing import Any

import cv2
import numpy as np


@dataclass(frozen=True)
class FaceCropResult:
    imagem_base64: str
    caminho_arquivo: str
    x: int
    y: int
    largura: int
    altura: int

    def to_dict(self) -> dict:
        return {
            "imagem_base64": self.imagem_base64,
            "caminho_arquivo": self.caminho_arquivo,
            "bounding_box": {
                "x": self.x,
                "y": self.y,
                "largura": self.largura,
                "altura": self.altura,
            },
        }


def _carregar_detector() -> cv2.CascadeClassifier:
    caminho = (
        Path(cv2.data.haarcascades)
        / "haarcascade_frontalface_default.xml"
    )

    detector = cv2.CascadeClassifier(str(caminho))

    if detector.empty():
        raise RuntimeError(
            f"Não foi possível carregar o detector: {caminho}"
        )

    return detector


_DETECTOR_FRONTAL = _carregar_detector()


def _limitar_caixa(
    x: int,
    y: int,
    largura: int,
    altura: int,
    largura_imagem: int,
    altura_imagem: int,
) -> tuple[int, int, int, int]:
    x1 = max(0, min(x, largura_imagem - 1))
    y1 = max(0, min(y, altura_imagem - 1))

    x2 = max(
        x1 + 1,
        min(x + largura, largura_imagem),
    )

    y2 = max(
        y1 + 1,
        min(y + altura, altura_imagem),
    )

    return x1, y1, x2, y2


def _detectar_faces_na_pessoa(
    recorte_pessoa: np.ndarray,
) -> list[tuple[int, int, int, int]]:
    altura, largura = recorte_pessoa.shape[:2]

    # Recortes muito pequenos não permitem uma
    # detecção facial minimamente confiável.
    if largura < 60 or altura < 100:
        return []

    # O rosto deve estar na parte superior da pessoa.
    limite_superior = max(
        1,
        int(altura * 0.55),
    )

    regiao_cabeca = recorte_pessoa[
        0:limite_superior,
        0:largura,
    ]

    cinza = cv2.cvtColor(
        regiao_cabeca,
        cv2.COLOR_BGR2GRAY,
    )

    clahe = cv2.createCLAHE(
        clipLimit=2.0,
        tileGridSize=(8, 8),
    )

    cinza = clahe.apply(cinza)

    tamanho_minimo = max(
        24,
        int(min(largura, altura) * 0.10),
    )

    deteccoes = _DETECTOR_FRONTAL.detectMultiScale(
        cinza,
        scaleFactor=1.08,
        minNeighbors=8,
        minSize=(
            tamanho_minimo,
            tamanho_minimo,
        ),
        flags=cv2.CASCADE_SCALE_IMAGE,
    )

    caixas_validas: list[
        tuple[int, int, int, int]
    ] = []

    for x, y, largura_face, altura_face in deteccoes:
        x = int(x)
        y = int(y)
        largura_face = int(largura_face)
        altura_face = int(altura_face)

        if altura_face <= 0:
            continue

        proporcao = largura_face / altura_face

        centro_x = (
            x + largura_face / 2
        ) / largura

        centro_y = (
            y + altura_face / 2
        ) / altura

        proporcao_largura = (
            largura_face / largura
        )

        proporcao_altura = (
            altura_face / altura
        )

        # Regras para eliminar cadeiras, monitores,
        # portas e outros objetos detectados como rosto.
        if not 0.75 <= proporcao <= 1.35:
            continue

        if not 0.08 <= centro_x <= 0.92:
            continue

        if centro_y > 0.48:
            continue

        if not 0.10 <= proporcao_largura <= 0.75:
            continue

        if not 0.06 <= proporcao_altura <= 0.38:
            continue

        caixas_validas.append(
            (
                x,
                y,
                largura_face,
                altura_face,
            )
        )

    # Prioriza o maior rosto válido.
    caixas_validas.sort(
        key=lambda caixa: caixa[2] * caixa[3],
        reverse=True,
    )

    return caixas_validas


def recortar_rosto(
    caminho_imagem: str,
    bounding_box: Any | None = None,
    pasta_saida: str = "recortes_faciais",
    nome_arquivo: str | None = None,
) -> FaceCropResult | None:
    # Nunca procurar rosto na cena inteira.
    # É obrigatório receber uma pessoa confirmada.
    if bounding_box is None:
        return None

    imagem = cv2.imread(caminho_imagem)

    if imagem is None:
        raise ValueError(
            f"Imagem inválida: {caminho_imagem}"
        )

    altura_imagem, largura_imagem = imagem.shape[:2]

    x1, y1, x2, y2 = _limitar_caixa(
        int(bounding_box.x),
        int(bounding_box.y),
        int(bounding_box.largura),
        int(bounding_box.altura),
        largura_imagem,
        altura_imagem,
    )

    recorte_pessoa = imagem[y1:y2, x1:x2]

    if recorte_pessoa.size == 0:
        return None

    caixas = _detectar_faces_na_pessoa(
        recorte_pessoa
    )

    if not caixas:
        return None

    x, y, largura_face, altura_face = caixas[0]

    margem_x = int(largura_face * 0.20)
    margem_y = int(altura_face * 0.25)

    rx1 = max(0, x - margem_x)
    ry1 = max(0, y - margem_y)

    rx2 = min(
        recorte_pessoa.shape[1],
        x + largura_face + margem_x,
    )

    ry2 = min(
        recorte_pessoa.shape[0],
        y + altura_face + margem_y,
    )

    recorte_rosto = recorte_pessoa[
        ry1:ry2,
        rx1:rx2,
    ]

    if recorte_rosto.size == 0:
        return None

    pasta = Path(pasta_saida)
    pasta.mkdir(
        parents=True,
        exist_ok=True,
    )

    if not nome_arquivo:
        nome_arquivo = (
            Path(caminho_imagem).stem
            + "_face.jpg"
        )

    if not nome_arquivo.lower().endswith(
        (".jpg", ".jpeg")
    ):
        nome_arquivo += ".jpg"

    caminho_saida = pasta / nome_arquivo

    salvo = cv2.imwrite(
        str(caminho_saida),
        recorte_rosto,
        [
            cv2.IMWRITE_JPEG_QUALITY,
            94,
        ],
    )

    if not salvo:
        raise RuntimeError(
            "Não foi possível salvar o recorte facial"
        )

    codificado, buffer = cv2.imencode(
        ".jpg",
        recorte_rosto,
        [
            cv2.IMWRITE_JPEG_QUALITY,
            94,
        ],
    )

    if not codificado:
        raise RuntimeError(
            "Não foi possível converter o recorte facial"
        )

    imagem_base64 = base64.b64encode(
        buffer.tobytes()
    ).decode("ascii")

    return FaceCropResult(
        imagem_base64=imagem_base64,
        caminho_arquivo=str(caminho_saida),
        x=x1 + rx1,
        y=y1 + ry1,
        largura=rx2 - rx1,
        altura=ry2 - ry1,
    )
