import asyncio
import json

from app.services.appearance_memory import (
    AppearanceMemory,
)
from app.services.scene_analyzer import (
    PersonVisualAnalysis,
)


def criar_analise(
    cor: str,
    rgb: tuple[int, int, int],
    percentual: float,
    posicao: str = "centro",
    tamanho: str = "medio",
) -> PersonVisualAnalysis:
    return PersonVisualAnalysis(
        cor_roupa_aproximada=cor,
        rgb_representativo=rgb,
        posicao_horizontal=posicao,
        tamanho_no_quadro=tamanho,
        percentual_quadro=percentual,
        descricao=(
            f"Pessoa com roupa {cor}."
        ),
    )


async def main() -> None:
    memoria = AppearanceMemory()

    pessoa_id = "camera-01-teste1234"

    primeira = await memoria.registrar(
        pessoa_id=pessoa_id,
        analise=criar_analise(
            cor="preta",
            rgb=(25, 25, 25),
            percentual=9.2,
        ),
    )

    segunda = await memoria.registrar(
        pessoa_id=pessoa_id,
        analise=criar_analise(
            cor="cinza",
            rgb=(85, 85, 85),
            percentual=7.4,
        ),
    )

    terceira = await memoria.registrar(
        pessoa_id=pessoa_id,
        analise=criar_analise(
            cor="preta",
            rgb=(35, 35, 35),
            percentual=8.1,
            posicao="direita",
        ),
    )

    print("===== PRIMEIRA AMOSTRA =====")
    print(
        json.dumps(
            primeira.to_dict(),
            ensure_ascii=False,
            indent=2,
        )
    )

    print("\n===== SEGUNDA AMOSTRA =====")
    print(
        json.dumps(
            segunda.to_dict(),
            ensure_ascii=False,
            indent=2,
        )
    )

    print("\n===== RESULTADO ESTÁVEL =====")
    print(
        json.dumps(
            terceira.to_dict(),
            ensure_ascii=False,
            indent=2,
        )
    )

    assert (
        terceira.cor_roupa_predominante
        == "preta"
    )

    assert (
        terceira.quantidade_amostras
        == 3
    )

    assert (
        terceira.posicao_atual
        == "direita"
    )

    resultado_final = await memoria.finalizar(
        pessoa_id
    )

    assert resultado_final is not None

    assert memoria.quantidade_sessoes == 0

    print(
        "\nTeste concluído com sucesso."
    )


if __name__ == "__main__":
    asyncio.run(main())